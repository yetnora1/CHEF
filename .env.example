# CHEF SIS — environment variables
# Copy to .env.local (git-ignored) and fill in values. Never commit real values.
#
# Local Supabase: run `npm run supabase:start` and copy the values it prints
# (or `npm run supabase:status`). Hosted Supabase: Project Settings → API Keys.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.

# --- Public (shipped to the browser by design) --------------------------------
# Supabase project URL. Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase *publishable* key (sb_publishable_...). Safe in the browser: every
# request it makes is still subject to Row Level Security.
# Never put a secret or service_role key here — the app refuses to use one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site origin for canonical URLs and links in emails. Required in
# production (https): the inquiry form stays closed without it, because CAPTCHA
# tokens are checked against its hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (CAPTCHA for the inquiry form).
# Local testing may use Cloudflare's published test key 1x00000000000000000000AA
# (always passes); test keys are refused in production builds.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only (never prefix with NEXT_PUBLIC_) ----------------------------
# Supabase *secret* key (sb_secret_...). Required for the inquiry form: the
# server uses it only to call submit_inquiry / consume_rate_limit and the
# email outbox functions (it has no direct table access). Keep it in the
# hosting provider's secret store in production.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile secret key. Required in production for the inquiry
# form; without it the form shows "not open yet" and nothing is accepted.
# Local test secret: 1x0000000000000000000000000000000AA (always passes).
TURNSTILE_SECRET_KEY=

# LOCAL DEVELOPMENT ONLY: set to "true" to accept inquiries without CAPTCHA.
# Ignored whenever NODE_ENV=production (every `next build` / `next start`).
INQUIRY_LOCAL_CAPTCHA_BYPASS=

# Request header carrying the visitor's IP for rate limiting. REQUIRED in
# production (the form stays closed without it): it must be a header your
# hosting proxy sets, never one the client controls; check your platform's
# docs (e.g. cf-connecting-ip when Cloudflare proxies straight to the app).
# Outside production the default is x-forwarded-for.
# CLIENT_IP_HEADER=
# For list headers such as x-forwarded-for: how many proxies you control
# (1-5, default 1). The entry that many places from the right is used.
# CLIENT_IP_TRUSTED_HOPS=1

# Optional transactional email (Resend). All three are needed (and, in
# production, an https NEXT_PUBLIC_SITE_URL); otherwise inquiries are still
# stored and no email is sent or claimed.
# RESEND_API_KEY=
# INQUIRY_EMAIL_FROM=CHEF SIS <inquiries@your-verified-domain.example>
# INQUIRY_NOTIFY_TO=comma,separated,business@addresses.example

# Optional: enables GET/POST /api/internal/notifications for a scheduler to
# retry queued emails (send `Authorization: Bearer <value>`). 32+ characters.
# CRON_SECRET=
